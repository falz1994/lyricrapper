# dependencias locales del alineador (se recrean con tools/requirements.txt)
tools/pylib/
tools/models/

# capturas y perfiles de Chrome de las pruebas
.tmp/

# audios: los webm/mp3 de assets/audio/ SÍ se versionan (los sirve Vercel en
# el mismo origen que el reproductor: HTTPS y CORS resueltos sin host externo).
# El resto de formatos no se versiona.
assets/audio/*.m4a
assets/audio/*.wav
assets/audio/*.flac
assets/audio/*.ogg

# copias de trabajo en la raíz del proyecto (fuente y letras de las canciones)
/*.mp3
/*.m4a
letra-*.txt

*.log
.DS_Store
__pycache__/

# eventos de la analítica local (no se versionan)
data/analytics.jsonl

# credenciales locales (NUNCA se versionan)
.env
.env.*
.vercel/
.vercel
